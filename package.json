{
  "name": "claude-desktop-zh-cn-overlay",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Claude Desktop Ultra - non-invasive Claude Desktop enhancer",
  "bin": {
    "claude-cn": "./bin/claude-cn.mjs"
  },
  "scripts": {
    "detect": "node ./bin/claude-cn.mjs detect",
    "doctor": "node ./bin/claude-cn.mjs doctor",
    "audit": "node ./bin/claude-cn.mjs audit",
    "launch": "node ./bin/claude-cn.mjs launch",
    "generate:icon": "node ./scripts/generate-icon.mjs",
    "build:exe": "node ./scripts/build-exe.mjs"
  },
  "pkg": {
    "scripts": [
      "bin/**/*.mjs",
      "src/**/*.mjs"
    ],
    "assets": [
      "profiles/**/*.json",
      "locales/**/*.json",
      "assets/**/*",
      "src/**/*.txt",
      "config/**/*.json",
      "vendor/**/*.zip",
      "README.md",
      "docs/**/*.md",
      "plugin.json"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
