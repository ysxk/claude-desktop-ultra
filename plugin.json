{
  "id": "claude-desktop.zh-cn-overlay",
  "name": "Claude ultra",
  "version": "0.1.5",
  "entry": "bin/claude-cn.mjs",
  "target": {
    "app": "Claude Desktop",
    "packageNames": ["Claude"],
    "installKinds": ["msix", "classic"],
    "versions": "*"
  },
  "strategy": {
    "nonInvasive": true,
    "writesIntoApplicationDirectory": false,
    "requiresAdministrator": false,
    "mechanism": "Launch a Claude ultra portable runtime with isolated user data, zh-CN locale, UI translation, third-party model sync, and compatibility patches."
  },
  "permissions": [
    "read-installed-claude-location",
    "launch-local-claude-process",
    "connect-localhost-devtools-port"
  ]
}
