{
  "locale": "zh-CN",
  "fallbackLocale": "en-US",
  "localeOverride": true,
  "name": "简体中文",
  "dictionaryFiles": [
    {
      "path": "../locales/claude-desktop.zh-CN.json",
      "audit": "official"
    },
    {
      "path": "../locales/web-common.zh-CN.json",
      "audit": "extra"
    }
  ],
  "translateAttributes": ["aria-label", "title", "placeholder", "alt"],
  "skipTextSelectors": [
    "script",
    "style",
    "noscript",
    "code",
    "pre",
    "kbd",
    "samp",
    "textarea",
    "input",
    "[contenteditable=\"true\"]",
    "[data-claude-cn-skip]"
  ],
  "pollIntervalMs": 1200
}
